#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_FILE="${ROOT_DIR}/.sky-provider"
DEFAULT_PROVIDER="runpod"
DEFAULT_TASK="${ROOT_DIR}/sky/hello.yaml"

cd "${ROOT_DIR}"

export UV_CACHE_DIR="${ROOT_DIR}/.uv-cache"

if [[ -f "${ROOT_DIR}/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "${ROOT_DIR}/.env"
  set +a
fi

CLUSTER_PREFIX="${SKY_CLUSTER_PREFIX:-sandbox-sky}"

usage() {
  cat <<'USAGE'
Usage:
  ./scripts/skyctl use <runpod|hyperbolic|lambda>
  ./scripts/skyctl current
  ./scripts/skyctl check
  ./scripts/skyctl gpus [provider]
  ./scripts/skyctl launch [task.yaml] [provider]
  ./scripts/skyctl logs [provider]
  ./scripts/skyctl status
  ./scripts/skyctl stop [provider]
  ./scripts/skyctl down [provider]

Examples:
  ./scripts/skyctl use runpod
  ./scripts/skyctl launch
  ./scripts/skyctl use hyperbolic
  ./scripts/skyctl launch sky/gpu-smoke.yaml
  ./scripts/skyctl use lambda
  ./scripts/skyctl launch sky/lambda-smoke.yaml
USAGE
}

normalize_provider() {
  local provider="${1:-}"
  case "${provider}" in
    runpod|hyperbolic|lambda) printf '%s\n' "${provider}" ;;
    *) echo "Expected provider: runpod, hyperbolic, or lambda" >&2; exit 2 ;;
  esac
}

current_provider() {
  if [[ -f "${STATE_FILE}" ]]; then
    normalize_provider "$(tr -d '[:space:]' < "${STATE_FILE}")"
  else
    printf '%s\n' "${DEFAULT_PROVIDER}"
  fi
}

provider_arg_or_current() {
  if [[ -n "${1:-}" ]]; then
    normalize_provider "${1}"
  else
    current_provider
  fi
}

cluster_for_provider() {
  local provider
  provider="$(normalize_provider "$1")"
  printf '%s-%s\n' "${CLUSTER_PREFIX}" "${provider}"
}

sky() {
  uv run sky "$@"
}

sky_launch() {
  uv run python scripts/sky_launch.py "$@"
}

cmd="${1:-}"
shift || true

case "${cmd}" in
  use)
    provider="$(normalize_provider "${1:-}")"
    printf '%s\n' "${provider}" > "${STATE_FILE}"
    echo "Active SkyPilot provider: ${provider}"
    ;;
  current)
    current_provider
    ;;
  check)
    sky check
    ;;
  gpus|show-gpus)
    provider="$(provider_arg_or_current "${1:-}")"
    sky gpus list --infra "${provider}"
    ;;
  launch)
    task="${1:-${DEFAULT_TASK}}"
    provider="$(provider_arg_or_current "${2:-}")"
    cluster="$(cluster_for_provider "${provider}")"
    sky_launch --infra "${provider}" -c "${cluster}" "${task}"
    ;;
  logs)
    provider="$(provider_arg_or_current "${1:-}")"
    cluster="$(cluster_for_provider "${provider}")"
    sky logs "${cluster}"
    ;;
  status)
    sky status
    ;;
  stop)
    provider="$(provider_arg_or_current "${1:-}")"
    cluster="$(cluster_for_provider "${provider}")"
    sky stop "${cluster}"
    ;;
  down)
    provider="$(provider_arg_or_current "${1:-}")"
    cluster="$(cluster_for_provider "${provider}")"
    sky down "${cluster}"
    ;;
  ""|-h|--help|help)
    usage
    ;;
  *)
    echo "Unknown command: ${cmd}" >&2
    usage >&2
    exit 2
    ;;
esac
