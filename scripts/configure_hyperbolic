#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${ROOT_DIR}/.env"
API_KEY_FILE="${HOME}/.hyperbolic/api_key"

if [[ -f "${ENV_FILE}" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "${ENV_FILE}"
  set +a
fi

if [[ -z "${HYPERBOLIC_API_KEY:-}" ]]; then
  echo "HYPERBOLIC_API_KEY is not set. Run this command through keyenv." >&2
  exit 2
fi

mkdir -p "$(dirname "${API_KEY_FILE}")"
umask 077
printf '%s\n' "${HYPERBOLIC_API_KEY}" > "${API_KEY_FILE}"
echo "Wrote ${API_KEY_FILE}"
