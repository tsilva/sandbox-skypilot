# Copy to .env and fill in local credentials. This file is safe to commit.

# RunPod:
# Either set this env var or run `uv run runpod config`.
RUNPOD_API_KEY=

# Hyperbolic:
# Also add your local SSH public key in the Hyperbolic dashboard.
HYPERBOLIC_API_KEY=

# Lambda Cloud:
# Either set this and run `./scripts/configure_lambda`, or create
# ~/.lambda_cloud/lambda_keys manually.
LAMBDA_API_KEY=

# Optional override for the cluster names used by ./scripts/skyctl.
SKY_CLUSTER_PREFIX=sandbox-sky
